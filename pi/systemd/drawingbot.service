[Unit]
Description=DrawingBot (servidor da máquina de desenho)
After=network.target drawingbot-config.service
Wants=drawingbot-config.service

[Service]
Type=simple
User=drawingbot
Group=drawingbot
SupplementaryGroups=dialout
Environment=PORT=80
Environment=DRAWINGBOT_STATIC=/opt/drawingbot/app
Environment=DRAWINGBOT_DATA=/var/lib/drawingbot
EnvironmentFile=-/etc/drawingbot/env
ExecStart=/usr/bin/node /opt/drawingbot/server.mjs
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/drawingbot

[Install]
WantedBy=multi-user.target
