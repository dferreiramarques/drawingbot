@echo off
setlocal
set "PEN_STUDIO_DIR=%~dp0"
powershell -NoProfile -Command "$root=$env:PEN_STUDIO_DIR; $url='http://127.0.0.1:8788'; $ready=$false; try { $ready=(Invoke-RestMethod ($url+'/health') -TimeoutSec 2).app -eq 'pen-studio' } catch {}; if(-not $ready) { $python=(Get-Command python.exe -ErrorAction SilentlyContinue).Source; if(-not $python) { Write-Host 'Python nao encontrado. Usa a versao publicada indicada no LEIA-ME.'; exit 1 }; $scriptArgument=([char]34)+(Join-Path $root 'serve.py')+([char]34); Start-Process -FilePath $python -ArgumentList $scriptArgument -WindowStyle Hidden -RedirectStandardOutput (Join-Path $root 'server.log') -RedirectStandardError (Join-Path $root 'server-error.log'); for($attempt=0;$attempt -lt 40;$attempt++) { Start-Sleep -Milliseconds 250; try { if((Invoke-RestMethod ($url+'/health') -TimeoutSec 1).app -eq 'pen-studio') { $ready=$true; break } } catch {} }; if(-not $ready) { Write-Host 'Nao foi possivel abrir a app local. Verifica server-error.log.'; exit 1 } }; $edge=Join-Path ${env:ProgramFiles(x86)} 'Microsoft\Edge\Application\msedge.exe'; $chrome=Join-Path $env:ProgramFiles 'Google\Chrome\Application\chrome.exe'; if(Test-Path $edge) { Start-Process -FilePath $edge -ArgumentList ('--app='+$url) } elseif(Test-Path $chrome) { Start-Process -FilePath $chrome -ArgumentList ('--app='+$url) } else { Start-Process $url }"
if errorlevel 1 pause
endlocal
